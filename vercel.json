{
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/leadscout",
      "destination": "/leadscout/index.html"
    },
    {
      "source": "/leadscout/(.*)",
      "destination": "/leadscout/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!leadscout|api).*)",
      "destination": "/index.html"
    }
  ]
}
